# Local build settings for the MotionKit connector. Copy to .env and edit — .env is gitignored, .env.example is not.

# Absolute path to the motionkit-editor repo root. `npm run build` copies the compiled animation scripts into <this>/server/static/animation-scripts. Use your OS-native path (Windows: D:/path/to/motionkit-editor).
MOTIONKIT_EDITOR_PATH=/home/you/Projects/motionkit-editor

# Optional. Defaults to this repo, so only set it if the build output lives somewhere other than the checkout running the script.
# MOTIONKIT_CONNECTOR_PATH=/home/you/Projects/motionkit-connector

# Set to true to compile the DevTools globals (__motionkitAnims, __motionkitCustomRegistry, __motionkitDevToolsLoaded) into the bundle. Required for the editor's DevTools panel to see any animation — without it webpack dead-code-eliminates all three and the panel stays empty. Leave unset when building the plugin for release.
MOTIONKIT_DEVTOOLS=true
